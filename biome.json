{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"assist": {
		"actions": {
			"preset": "recommended",
			"source": {
				"organizeImports": "on",
				"preset": "recommended",
				"useSortedKeys": "on"
			}
		},
		"enabled": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"@types/**",
			"data/**",
			"!lib",
			"source/**",
			"*.*",
			"!package.json"
		]
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"rules": {
			"style": {
				"useArrayLiterals": "off"
			}
		}
	}
}
