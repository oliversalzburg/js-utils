  "scripts": {
    "prepack": "rm lib/tsconfig.tsbuildinfo",
    "preversion": "make lint test",
    "postversion": "git push"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "@types/web": "0.0.354",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
