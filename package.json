{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@oliversalzburg/js-utils",
  "version": "0.7.1",
  "license": "MIT",
  "author": "Oliver Salzburg <oliver.salzburg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliversalzburg/js-utils.git"
  },
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
